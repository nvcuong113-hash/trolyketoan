# Supabase project settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never place this in Streamlit client-visible code or GitHub.
SUPABASE_SECRET_KEY=

# SePay webhook authentication: configure the same API Key in SePay.
SEPAY_WEBHOOK_API_KEY=

# Bank account for VietQR. Never commit real account details to a public repository.
PAYMENT_BANK=
PAYMENT_ACCOUNT=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_REQUIRE_SEVQR=false

# Optional AI service for legal RAG. Do not send raw customer accounting data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
