# Supabase project settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never place this in Streamlit client-visible code or GitHub.
SUPABASE_SECRET_KEY=

# Prefer HMAC-SHA256 (same secret in SePay); API Key is the fallback.
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_HMAC_SECRET=
BILLING_WORKER_TOKEN=

# Bank account for VietQR. PAYMENT_BANK must be a short_name/alias from https://vietqr.app/banks.json. Never commit real account details.
PAYMENT_BANK=
PAYMENT_ACCOUNT=
PAYMENT_ACCOUNT_HOLDER=
# true for VietinBank personal/household accounts if required by SePay's bank-specific rules.
PAYMENT_REQUIRE_SEVQR=false

# AI OCR documents and payment reconciliation (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional AI service for legal RAG only; FR-09 OCR does not use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated Supabase Auth UUIDs allowed to publish official legal documents to private Supabase Storage.
LEGAL_ADMIN_USER_IDS=
